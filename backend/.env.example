# Entorno de ejecución: development | production | test
NODE_ENV=development
# Puerto de la API
PORT=4000
# Cadena de conexión de Prisma. SQLite: ruta relativa a backend/prisma/
DATABASE_URL="file:./data/mesa.db"
# Secreto para firmar la sesión (mínimo 32 caracteres). Obligatorio en producción.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Duración de la sesión en horas
SESSION_HOURS=8
# Coste del hash bcrypt (10-14 recomendado)
BCRYPT_ROUNDS=12
# Intentos de inicio de sesión permitidos por IP en la ventana indicada
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
